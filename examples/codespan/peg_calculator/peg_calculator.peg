// An example of using a PEG parser generated by pigeon with srcspan.
// (`peg_calculator` of codespan-reporting in Rust, which uses `peg`)
//
// peg_calculator.go is generated from this grammar. To regenerate it, and
// to run this example, execute the following commands from the top level of
// this repository:
//
// ```sh
// go run github.com/mna/pigeon@v1.3.0 -o examples/codespan/peg_calculator/peg_calculator.go examples/codespan/peg_calculator/peg_calculator.peg
// go run ./examples/codespan/peg_calculator "3 + (2 - 5 * 12)"
// ```


{
// Command calculator is a small PEG-generated parser that computes
// simple math using integers.
//
// Example usage: $ calculator "3 + (2 - 5 * 12)"
//
// Inspired by pegjs arithmetic example:
// https://github.com/pegjs/pegjs/blob/master/examples/arithmetics.pegjs
//
// This example shows how the errors of an existing PEG parser are reported
// with srcspan, like `peg_calculator` of codespan-reporting in Rust. The
// parser (pigeon instead of `peg`), the grammar (based on pigeon's
// calculator example) and the input (an argument instead of a REPL) differ
// from the Rust version, but the diagnostic is built in the same way.
package main

//go:generate go run github.com/mna/pigeon@v1.3.0 -o peg_calculator.go peg_calculator.peg

import (
    "strings"

    "srcspan/diagnostic"
    "srcspan/files"
    "srcspan/term"
)

var ops = map[string]func(int, int) int {
    "+": func(l, r int) int {
        return l + r
    },
    "-": func(l, r int) int {
        return l - r
    },
    "*": func(l, r int) int {
        return l * r
    },
    "/": func(l, r int) int {
        return l / r
    },
}

// for testing purpose
var cntCodeBlocks int

func main() {
    if len(os.Args) != 2 {
        log.Fatal("Usage: calculator 'EXPR'")
    }
    got, err := ParseReader("", strings.NewReader(os.Args[1]))
    if err != nil {
	el := err.(errList)

	fs := files.NewSimpleFiles()
	file := fs.Add("<repl>", os.Args[1])

	styles := term.DefaultColor()
	//	styles.ColorOutput = colorOutput
	writer := term.NewStylesWriter(os.Stderr, styles)
	config := term.DefaultConfig()

	for _, e := range el {
	    pe := e.(*parserError)

	    offset := pe.pos.offset

	    diagnostic := diagnostic.NewError().
		WithMessage("parse error").
		WithLabel(*diagnostic.NewPrimary(file, files.NewRange(offset, offset)).WithMessage("parse error")).
		WithNotes([]string{fmt.Sprintf("expected: %s", expected(pe.expected))})

		err := term.EmitToWriteStyle(writer, &config, &fs, diagnostic)
		if err != nil {
			os.Exit(1)
		}
	}
	os.Exit(1)	    
    }
    fmt.Println("=", got)
}

// Formats the expected tokens like `Display for ExpectedSet` of the `peg`
// crate in Rust: the token itself, or "one of" the tokens.
func expected(tokens []string) string {
    if len(tokens) == 1 {
        return tokens[0]
    }
    return "one of " + strings.Join(tokens, ", ")
}

func toAnySlice(v any) []any {
    if v == nil {
        return nil
    }
    return v.([]any)
}

func eval(first, rest any) int {
    l := first.(int)
    restSl := toAnySlice(rest)
    for _, v := range restSl {
        restExpr := toAnySlice(v)
        r := restExpr[3].(int)
        op := restExpr[1].(string)
        l = ops[op](l, r)
    }
    return l
}
}

Input <- expr:Expr EOF {
    cntCodeBlocks++
    return expr, nil
}

Expr <- _ first:Term rest:( _ AddOp _ Term )* _ {
    cntCodeBlocks++
    return eval(first, rest), nil
}

Term <- first:Factor rest:( _ MulOp _ Factor )* {
    cntCodeBlocks++
    return eval(first, rest), nil
}

Factor <- '(' expr:Expr ')' {
    cntCodeBlocks++
    return expr, nil
} / integer:Integer {
    cntCodeBlocks++
    return integer, nil
}

AddOp <- ( '+' / '-' ) {
    cntCodeBlocks++
    return string(c.text), nil
}

MulOp <- ( '*' / '/' ) {
    cntCodeBlocks++
    return string(c.text), nil
}

Integer <- '-'? [0-9]+ {
    cntCodeBlocks++
    return strconv.Atoi(string(c.text))
}

_ "whitespace" <- [ \n\t\r]*

EOF <- !.
